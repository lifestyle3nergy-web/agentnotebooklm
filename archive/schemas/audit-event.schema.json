{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twgt.org.nz/schemas/audit-event.schema.json",
  "title": "TWGT Output Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "event_type",
    "occurred_at",
    "actor",
    "inputs",
    "action",
    "result",
    "provenance",
    "authorization_state"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "minLength": 12,
      "maxLength": 160
    },
    "event_type": {
      "enum": [
        "INGEST",
        "NORMALIZE",
        "CLASSIFY",
        "ENRICH",
        "POLICY_EVALUATION",
        "SEARCH",
        "EXPORT",
        "GENERATE",
        "VERIFY",
        "REVIEW",
        "MIGRATE",
        "PRESERVE",
        "DELETE_REQUEST",
        "RESTORE",
        "INCIDENT"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "service",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string"
        },
        "delegated_by": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "version"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "parameters_digest": {
          "type": "string"
        },
        "model_provider": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "prompt_template_version": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "PARTIAL",
            "HELD",
            "CANCELLED"
          ]
        },
        "output_asset_id": {
          "type": "string"
        },
        "output_digest": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "evidence_uris": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_version",
        "policy_version"
      ],
      "properties": {
        "code_version": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "environment_digest": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "authorization_state": {
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "AUTHORIZED",
        "DENIED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "authorization_ref": {
      "type": "string"
    },
    "reviewer_ref": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED",
        "UNKNOWN"
      ]
    },
    "retention_class": {
      "type": "string"
    },
    "previous_audit_id": {
      "type": "string"
    }
  }
}
